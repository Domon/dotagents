{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/scripts/subagent-statusline.rb"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ban-words.rb",
            "timeout": 10,
            "statusMessage": "checking banned words"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/turn-cost.rb",
            "timeout": 15,
            "statusMessage": "computing turn cost"
          }
        ]
      }
    ]
  }
}
